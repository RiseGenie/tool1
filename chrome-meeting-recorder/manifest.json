{
  "manifest_version": 3,
  "name": "Meeting Recorder & Notes",
  "version": "1.0.0",
  "description": "Record a meeting's screen in one click, get a live transcript, and auto-email an AI summary with highlighted to-dos.",
  "permissions": ["storage"],
  "host_permissions": ["https://api.anthropic.com/*", "https://api.resend.com/*"],
  "action": {
    "default_title": "Start Meeting Recording",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html"
}

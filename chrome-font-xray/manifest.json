{
  "manifest_version": 3,
  "name": "Font X-Ray — Type System Inspector",
  "version": "1.0.0",
  "description": "Hover any text to see its exact font, size, weight, line-height and letter-spacing. Scan a whole page to build a type system report of every text style in use.",
  "permissions": ["storage", "activeTab", "scripting", "clipboardWrite"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Font X-Ray — Inspect type",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-inspector": {
      "suggested_key": {
        "default": "Ctrl+Shift+F",
        "mac": "Command+Shift+F"
      },
      "description": "Toggle hover font inspector"
    }
  }
}
